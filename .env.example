# Database
DATABASE_URL=postgresql+asyncpg://memory_user:memory_pass@localhost:5432/memory_db

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Embedding
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Retrieval weights (must sum to 1.0)
SEMANTIC_WEIGHT=0.6
DECAY_WEIGHT=0.4

# Decay
DECAY_JOB_INTERVAL_MINUTES=15

# Guardrails
CONTRADICTION_THRESHOLD=0.85
DEDUPLICATION_THRESHOLD=0.95
MAX_WRITES_PER_MINUTE=100
STALENESS_THRESHOLD=0.05
